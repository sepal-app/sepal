# -*- mode: conf -*-
#
# Do not quote values and do not use $HOME or ${PWD} here. devenv's dotenv
# reader is not a shell: it keeps quotes as part of the value and does not
# expand variables, so COOKIE_SECRET="..." arrives 18 characters long and fails
# validation at startup. Write absolute paths in full.

# The path do a World Flora Online Sqlite database. This variable is only necessary when
# initializing a new database. For more information see:
# https://github.com/brettatoms/wfo-plantlist-sqlite
WFO_DATABASE_PATH=wfo_plantlist_2025-06_1.db

# devenv sets EXTENSIONS_LIBRARY_PATH, SEPAL_DATA_HOME, MIGRATIONS_DIR,
# SCHEMA_DUMP_FILE and VITE_CONFIG_FILE for local development — see devenv.nix.
# Don't set them here: devenv's dotenv reader does not expand ${PWD}, and a value
# in this file would collide with the one devenv provides. In production
# SEPAL_DATA_HOME comes from the deployment environment, defaulting to
# $XDG_DATA_HOME/Sepal (~/.local/share/Sepal on Linux, ~/Library/Application
# Support/Sepal on macOS).

# Path to the sqlite-migrate script, as an absolute path. See
# https://github.com/brettatoms/sqlite-migrate
MIGRATE_SH=/home/you/devel/sqlite-migrate/migrate.sh

# The secret used to encrypt cookies.  [REQUIRED]
COOKIE_SECRET=

# Secret for encrypting tokens (password reset, invitations, etc.) [REQUIRED]
# Must be at least 16 characters
TOKEN_SECRET=

# The reply to email address for password reset emails
FORGOT_PASSWORD_EMAIL_FROM=

# The subject to use for the password reset emails
FORGOT_PASSWORD_EMAIL_SUBJECT=

# The domain used to link back to the deployed app. For example the domain to use for the
# reset password links. [REQUIRED]
APP_DOMAIN=

# SMTP configuration for sending emails. [REQUIRED]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=starttls

# Environment variables for uploading media.  These can be from an AWS compatible S3 API.  Required if you want to upload media.
MEDIA_UPLOAD_BUCKET=
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Prefix for media S3 keys (default: "media/")
# All uploaded media files will be stored under this prefix in the bucket
MEDIA_KEY_PREFIX=media/

# Image thumbnail cache size in MB (default: 500)
# Thumbnails are cached in $SEPAL_DATA_HOME/cache/
IMAGE_CACHE_SIZE_MB=500

# Set these for init script or for local development so that an initial admin user gets created with a new database.
# user
ADMIN_EMAIL=
ADMIN_PASSWORD=
