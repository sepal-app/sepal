# -*- mode: conf -*-
#
# Copy to .env.local and fill in. Only SEPAL_SECRET is required.
# The full variable list, with defaults, is in README.md.
#
# Don't quote values and don't use $HOME or ${PWD}. devenv's dotenv reader is
# not a shell: quotes stay part of the value and variables are not expanded.
# Write absolute paths out in full.
#
# EXTENSIONS_LIBRARY_PATH and SEPAL_DATA_HOME are set by devenv.nix. Don't set
# them here.

# Master secret, minimum 16 characters. Generate with: openssl rand -hex 16
SEPAL_SECRET=

# Domain used to build links in outgoing email. Defaults to localhost.
APP_DOMAIN=

# Defaults: 0.0.0.0, 3000, DEBUG, $SEPAL_DATA_HOME/backups.
# HOST=
# PORT=
# LOG_LEVEL=
# BACKUP_PATH=


# --- Email -----------------------------------------------------------------
#
# Optional. Uncomment once filled in: an absent SMTP_HOST leaves email off, but
# a blank one turns it on with unusable settings.
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_TLS=starttls

# Logs every address and every server reply to stdout.
# SMTP_DEBUG=true

# Sender addresses and subject lines, with their defaults.
# FORGOT_PASSWORD_EMAIL_FROM=support@sepal.app
# FORGOT_PASSWORD_EMAIL_SUBJECT=Sepal - Reset Password
# INVITATION_EMAIL_FROM=noreply@sepal.app
# INVITATION_EMAIL_SUBJECT=You've been invited to Sepal


# --- Media uploads ---------------------------------------------------------
#
# Optional, and any S3-compatible store works. Give the endpoint as an origin
# with no bucket path: the bucket is appended from MEDIA_UPLOAD_BUCKET. The
# bucket needs a CORS rule allowing PUT from your app's origin with the
# content-type header; see README.md.
#
# Uncomment once filled in: an absent AWS_ACCESS_KEY_ID leaves media upload
# off, but a blank one turns it on with unusable credentials.
#
# AWS_S3_ENDPOINT=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_UPLOAD_BUCKET=

# Defaults: media/ and 500.
# MEDIA_KEY_PREFIX=media/
# IMAGE_CACHE_SIZE_MB=500


# --- Development -----------------------------------------------------------
#
# Read by bin/reset-db.sh, which rebuilds a development database from the full
# WFO Plantlist. A normal install needs none of them.
# WFO_DATABASE_PATH=
# MIGRATE_SH=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Pin the nREPL port so editor tooling can find it.
# NREPL_PORT=
