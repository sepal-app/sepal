#kaocha/v1
 ;; kaocha-focus makes `--focus <namespace>` load only that namespace instead of
 ;; all 125. See bases/app/test/sepal/app/test/kaocha_focus.clj for when it
 ;; declines to narrow.
 {:plugins [:sepal.app.test/kaocha-focus]
  :tests [{:id :unit
           :test-paths ["bases/app"
                        "components/accession/test"
                        "components/activity/test"
                        "components/aws-s3/test"
                        "components/collection/test"
                        "components/config/test"
                        "components/contact/test"
                        "components/database/test"
                        "components/error/test"
                        "components/media-transform/test"
                        "components/location/test"
                        "components/logging/test"
                        "components/mail/test"
                        "components/malli/test"
                        "components/material/test"
                        "components/media/test"
                        "components/note/test"
                        "components/scheduler/test"
                        "components/search/test"
                        "components/settings/test"
                        "components/store/test"
                        "components/synonym/test"
                        "components/tag/test"
                        "components/taxon/test"
                        "components/test/test"
                        "components/token/test"
                        "components/user/test"
                        "components/validation/test"]
           ;; Exclude e2e test namespaces (prevents loading Playwright classes)
           :ns-patterns ["^(?!.*\\.e2e\\.).*-test$"]
           :kaocha.filter/skip-meta [:e2e]}

          {:id :e2e
           :test-paths ["bases/app"]
           :ns-patterns [".*e2e.*-test"]
           :kaocha.filter/focus-meta [:e2e]}]}
